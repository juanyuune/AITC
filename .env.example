# AITC Credit Investigation Chatbot — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to git (it's in .gitignore).

# ── vLLM / Breeze2-8B (on-premise model) ─────────────────────
VLLM_BASE_URL=http://localhost:8080/v1
VLLM_MODEL=/home/user/models/breeze2-8b
VLLM_TEMPERATURE=0.1
VLLM_MAX_TOKENS=2048

# ── XBRL MCP Server ──────────────────────────────────────────
XBRL_DB_PATH=/home/user/AITC/FinancialStatementXBRL.db
XBRL_HOST=0.0.0.0
XBRL_PORT=8091

# ── Query Cache ───────────────────────────────────────────────
# How long to cache answers before re-querying the DB (in hours).
# Set to 0 to disable caching entirely.
CACHE_TTL_HOURS=24
CACHE_FILE=src/services/query_result_cache.json

# ── Pipeline Timeout ──────────────────────────────────────────
# Maximum seconds to wait for a full pipeline run before returning timeout error.
# Complex XBRL queries can take 2–3 minutes; 180s gives comfortable headroom.
PIPELINE_TIMEOUT=180

# ── Frontend / CORS ───────────────────────────────────────────
# The React frontend origin. Add additional origins in app.py if needed.
FRONTEND_URL=http://192.168.20.169:3000
